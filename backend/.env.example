FOREST_API_BASE_URL=https://booking.forestrajasthan.com
# No API key is used — no official documented API requiring credentials was found.
# FOREST_API_KEY=
FOREST_API_TIMEOUT=45000
# browser = Chromium fetch (default). http = plain fetch (blocked by Cloudflare). ingest_only = paste/sync only.
FOREST_FETCH_MODE=browser
FOREST_BROWSER_PROFILE_DIR=./.forest-browser-profile
FOREST_BROWSER_HEADLESS=true
AVAILABILITY_CACHE_TTL=300
AVAILABILITY_INGEST_TTL=300
AVAILABILITY_REFRESH_INTERVAL=300
PORT=4000

# Local/dev only: parse a saved HTML or bookingStats JSON fixture instead of live network.
# FOREST_HTML_FIXTURE_PATH=./src/__tests__/fixtures/bookingStats.sample.json
# FOREST_USE_FIXTURE_ONLY=true
# FOREST_ALLOW_FIXTURE_FALLBACK=false

# When Cloudflare blocks server fetch, sync from your browser via:
# POST /api/safari/ingest  with { "raw": "<bookingStats json or html>" }
